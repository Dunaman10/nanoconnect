{
  "name": "nanoconnect",
  "version": "1.0.0",
  "description": "NanoConnect - Platform Nano Influencer Marketing untuk UMKM Indonesia",
  "build": {
    "command": "npm install && npm run build",
    "output": "dist"
  },
  "routes": [
    {
      "path": "/stat-cache",
      "function": "edge-functions/stat-cache"
    },
    {
      "path": "/api/*",
      "function": "functions"
    },
    {
      "path": "/*",
      "static": "dist"
    }
  ],
  "functions": {
    "directory": "functions",
    "runtime": "nodejs"
  },
  "caches": [
    {
      "source": "/assets/*",
      "cacheTtl": 31536000
    },
    {
      "source": "/images/*",
      "cacheTtl": 86400
    },
    {
      "source": "/*.js",
      "cacheTtl": 604800
    },
    {
      "source": "/*.css",
      "cacheTtl": 604800
    }
  ],
  "headers": [
    {
      "source": "/*",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "statusCode": 301
    }
  ]
}